// Cap FASTQC's container at 200 MB of RAM (cgroup limit enforced by Apptainer).
// FastQC needs ~600 MB on the test data (see fixtures/demo-ok trace), so the
// kernel OOM-killer terminates it, as a SLURM cgroup would on a real cluster.
process {
    withName: 'FASTQC' {
        containerOptions = '--memory 200M --memory-swap 200M'
    }
}
